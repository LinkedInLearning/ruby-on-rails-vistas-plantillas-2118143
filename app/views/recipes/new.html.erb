<%= stylesheet_link_tag "recipes", media: "all" %>

<h1>Nueva Receta</h1>
<div class="recipe-form-container">

  <%= form_with class: 'recipe-form',model: @recipe, url: recipes_path, method: :post do |form| %>
    <label for="title">Título:</label>
    <%= form.text_field :title %>

    <label>Selecciona los granos de café y su cantidad:</label>
  <div class="bean-selection">
    <div class="bean-group">
      <%= select_tag "recipe[recipe_beans_attributes][][bean_id]", options_from_collection_for_select(Bean.all, :id, :name), { prompt: "Selecciona un grano" , class: "bean-select" } %>
      <%= text_field_tag "recipe[recipe_beans_attributes][][amount]", nil, placeholder: "Cantidad en g", class: "bean-amount" %>
    </div>
  </div>


    <label for="description">Descripción:</label>
    <%= form.text_area :description %>

    <label for="instructions">Instrucciones:</label>
    <%= form.text_area :instructions %>

    <label for="difficulty">Dificultad:</label>
    <%= form.select :difficulty, [1,2,3] %>

    <%= form.button "Guardar Receta", class: "recipe-form button" %>
  <% end %>
</div>