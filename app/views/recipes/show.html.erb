<h1 class="recipe-title"><%= @recipe.title %></h1>

<%# Esto es un comentario en ERB y no aparecerá en el HTML %>

<% if @recipe.difficulty == 1 %>
  <h3>💡 Esta receta es fácil de preparar.</h3>
<% end %>

<%= "Esta línea se imprimirá en el HTML." %>

<%# Este comentario no aparece en la salida HTML %>

<div class="recipe-container">
  <p><strong>Descripción (Escapada por defecto):</strong></p>
  <p><%= @recipe.description %></p>

  <p><strong>Descripción con `html_safe`:</strong></p>
  <%# Desescapa el HTML y permite etiquetas como <b>, <p>, <br>, etc. %>
  <p><%= @recipe.description.html_safe %></p>

  <p><strong>Descripción con `raw`:</strong></p>
  <%# Hace lo mismo que html_safe, pero más flexible para estructuras de datos. %>
  <p><%= raw @recipe.description %></p>

  <p><strong>Descripción con `h` (Escapada manualmente):</strong></p>
  <%# Escapa los caracteres HTML, evitando ataques XSS. Usar cuando no quieras mostrar HTML en la salida. %>
  <p><%= h(@recipe.description) %></p>

  
  <p><strong>Instrucciones:</strong></p>
  <p><%= @recipe.instructions %></p>

  <p><strong>Dificultad:</strong> <%= format_difficulty(@recipe.difficulty) %></p>

  <p>
    <strong>Creado por:</strong> 
    <%= link_to @recipe.user.email, user_path(@recipe.user) -%>
  </p>

  <p><strong>Granos de café utilizados:</strong></p>
  <ul>
    <% @recipe.recipe_beans.each do |recipe_bean| %>
      <li><%= recipe_bean.bean.name %> - <%= recipe_bean.amount %> gr</li>
    <% end %>
  </ul>

  <div class="recipe-buttons">
    
    <%= link_to "Volver a Recetas", recipes_path, class: "btn-back" %>
  </div>
</div>
